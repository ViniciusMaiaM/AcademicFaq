# OpenAI API Key - Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI Model Configuration
# Options: gpt-3.5-turbo (cheaper), gpt-4 (better quality), gpt-4-turbo, etc.
OPENAI_MODEL=gpt-3.5-turbo
# Para SQLite (padrão)
DB_ENGINE=sqlite

# Para PostgreSQL
# DB_ENGINE=postgresql
# DB_USER=seu_usuario
# DB_PASSWORD=sua_senha
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=nome_do_banco
# SECRET_KEY

# Rate limiting da rota /ask (formato da lib `limits`, ex.: "10/minute", "100/hour")
# RATE_LIMIT_ASK=10/minute

# Rate limiting de /auth/register e /auth/login — mais restritivo que
# RATE_LIMIT_ASK de propósito (alvo natural de força bruta/spam de cadastro)
# RATE_LIMIT_AUTH=5/minute

# Guardrail contra alucinação: score mínimo de relevância (0-1) para um
# chunk recuperado ser considerado relacionado à pergunta. Abaixo disso, a
# pergunta cai direto no fallback sem chamar o LLM.
# RAG_MIN_RELEVANCE_SCORE=0.2

# Cache semântico: reaproveita a resposta de uma pergunta já respondida
# quando uma nova pergunta é semanticamente parecida (mesmo sem bater o hash
# exato). SEMANTIC_CACHE_MIN_SIMILARITY é o score mínimo (0-1) pra considerar
# um match — threshold alto e conservador de propósito, um falso positivo
# serve a resposta ERRADA com confiança total.
# SEMANTIC_CACHE_ENABLED=true
# SEMANTIC_CACHE_MIN_SIMILARITY=0.85
