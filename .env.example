# OpenAI API Key - Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI Model Configuration
# Options: gpt-3.5-turbo (cheaper), gpt-4 (better quality), gpt-4-turbo, etc.
OPENAI_MODEL=gpt-3.5-turbo
# Para SQLite (padrão)
DB_ENGINE=sqlite

# Para PostgreSQL
# DB_ENGINE=postgresql
# DB_USER=seu_usuario
# DB_PASSWORD=sua_senha
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=nome_do_banco
# SECRET_KEY
